{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cisco Catalyst Center (DNA Center) Intent Authentication CommandRunner API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "CommandRunner",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Run a read-only CLI command against devices",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{controllerHost}/dna/intent/api/v1/network-device-poller/cli/read-request",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Run a read-only CLI command against devices"
        }
      ]
    }
  ],
  "bundled": true
}